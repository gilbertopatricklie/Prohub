POSTGRES_DB=exampledb
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password
DATABASE_URL=postgresql+psycopg://example_user:example_password@localhost:[your internal/local port]/exampledb

#Adjust your local/internal port at the docker-compose.yaml
#(if you have a running postgresql app port 5432 (the port that postgresql used) might be occupied.)
#The solution to the problem above is to just use a different non-occupied loacl/internal port such as 5234/any.
#But the port used for postgres inside the docker container must still be 5432.
#Becuz ur local/internal port is just being used as a "redirector" to the postgres port inside docker container.